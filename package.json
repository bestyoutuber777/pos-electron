{
  "name": "pos-electron",
  "version": "0.2.0",
  "description": "POS desktop app: Electron + React + SQLite",
  "main": "main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "npm-run-all --parallel dev:renderer dev:electron",
    "start": "electron .",
    "build": "vite build"
  },
  "dependencies": {
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "cross-env": "^7.0.3"
  }
}